---
import '@fontsource-variable/geologica';
import '../styles/global.css';
import home from '../data/home.json';
import { u } from '../lib';

interface Props { title?: string; description?: string; image?: string }
const { title = home.seo_title, description = home.seo_description, image } = Astro.props;
const ogImage = image ? new URL(u(image), Astro.site).href : undefined;
const path = Astro.url.pathname;
const isHome = path === u('/') || path === u('/').replace(/\/$/, '');
const anchor = (id: string) => (isHome ? `#${id}` : `${u('/')}#${id}`);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#f5ede3" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="header">
      <div class="wrap header__in">
        <a class="header__name" href={u('/')}>{home.name}</a>
        <nav class="nav" aria-label="Разделы">
          <a href={anchor('cases')}>Кейсы</a>
          <a href={anchor('about')}>Обо мне</a>
          <a href={anchor('contacts')}>Контакты</a>
        </nav>
        <a class="btn btn--ghost btn--small" href={home.links.resume} target="_blank" rel="noopener">Резюме <span class="pdf">PDF</span></a>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
